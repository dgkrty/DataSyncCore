<Window x:Class="DataSync.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DataSync Core - Offline Replication Engine" Height="600" Width="950"
        Background="#121212" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,1,0" Padding="15">
            <StackPanel>
                <TextBlock Text="DATASYNC CORE" Foreground="#4DA6FF" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>
                
                <TextBlock Text="Source Database" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="Server=localhost;Database=ProdDB;" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Target Export Path" Foreground="#AAA" FontSize="12" Margin="0,0,0,5"/>
                <TextBox Text="C:\DataSync\Exports\" Background="#2D2D2D" Foreground="White" BorderThickness="0" Padding="5" Margin="0,0,0,25"/>

                <Button Name="BtnGenerate" Content="Generate Offline Package" Background="#4DA6FF" Foreground="Black" FontWeight="Bold" Padding="10" BorderThickness="0" Click="BtnGenerate_Click" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Main Telemetry Console -->
        <Grid Grid.Column="1" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Text="Execution Telemetry &amp; DAG Resolver" Foreground="#FFF" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10"/>
            
            <ScrollViewer Grid.Row="1" Background="#0A0A0A" Padding="10">
                <TextBlock Name="TxtConsole" Foreground="#00FF00" FontFamily="Consolas" FontSize="13" TextWrapping="Wrap"/>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
